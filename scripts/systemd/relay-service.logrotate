# Relay Service — systemd stdout/stderr 日志轮转
# 安装：cp scripts/systemd/relay-service.logrotate /etc/logrotate.d/relay-service
#
# 策略：
#   - 每日轮转，单文件超 50M 也触发切割
#   - 保留 7 天，压缩归档
#   - copytruncate：不中断服务（systemd append 模式）
#   - 总量上限约 7 × 50M × 2 文件 ≈ 700M 未压缩，压缩后 ~70M

/opt/relay-service/logs/stdout.log
/opt/relay-service/logs/stderr.log
{
    daily
    rotate 7
    maxsize 50M
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    dateext
    dateformat -%Y%m%d
}
